<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately net10.0, not net10.0-windows: no ASP.NET, no WinForms. One of these runs per
         session, so a small image is the whole point of it being a separate project rather than a
         "pty host" switch on Hangar.exe: ~6 MB compiled natively, ~15 MB as a trimmed single file
         (scripts\build.ps1 picks which), against ~115 MB for the daemon. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hangar.PtyHost</RootNamespace>
    <AssemblyName>Hangar.PtyHost</AssemblyName>
    <AssemblyTitle>Hangar session host</AssemblyTitle>
    <Product>Hangar</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The host is launched DETACHED_PROCESS with no console; nothing would read a console anyway,
         and diagnostics go to its per-session log file. -->
    <StartupObject>Hangar.PtyHost.Host</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Porta.Pty" Version="1.0.7" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire types, the VT stripper and the ring buffer are compiled into both this project and
         the web app: they are the contract between the two processes, so they must not drift. -->
    <Compile Include="..\shared\Pty\*.cs" LinkBase="Shared" />
    <Compile Include="..\shared\Common\*.cs" LinkBase="Shared" />
  </ItemGroup>

</Project>
