<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The only Windows-only project, by design: a tray icon is Windows UI, and everything behind it is
         the daemon's. It talks to the daemon over HTTP and /hub/events exactly as a browser does. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Windows GUI subsystem: no console window when it starts at logon. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hangar.Tray</RootNamespace>
    <AssemblyName>Hangar.Tray</AssemblyName>
    <!-- The name Windows puts on the tray's notifications (and in Task Manager): the version
         resource's description, which otherwise repeats AssemblyName ("Hangar.Tray"). -->
    <AssemblyTitle>Hangar</AssemblyTitle>
    <Product>Hangar</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The exe's icon (Explorer, Task Manager, the header of the tray's notifications). -->
    <ApplicationIcon>..\assets\hangar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tray icon itself, connected and not (built by scripts\make-icons.py). -->
    <EmbeddedResource Include="..\assets\hangar.ico" LogicalName="Hangar.Tray.hangar.ico" />
    <EmbeddedResource Include="..\assets\hangar-offline.ico" LogicalName="Hangar.Tray.hangar-offline.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The session and project records, and the membership rules the running-sessions menu is built
         from. Shared source with the daemon, so the two describe the same world. -->
    <Compile Include="..\shared\Contract\*.cs" LinkBase="Contract" />
    <Compile Include="..\shared\Common\*.cs" LinkBase="Contract" />
    <Using Include="Hangar.Contract" />
  </ItemGroup>

</Project>
