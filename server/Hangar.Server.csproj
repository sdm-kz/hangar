<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- The daemon. Plain net10.0: no WinForms and no UI of its own — the tray is a separate project
         (tray\) and only a client of this app's API. It runs on Windows, Linux and macOS; what differs
         between them (the pty host launch, the shell catalog, the updater) is chosen at run time with
         OperatingSystem.IsWindows(). -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- No console window when it starts at logon. Only Windows has a GUI subsystem to pick; anywhere
         else this builds an ordinary executable. -->
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Hangar.Server</RootNamespace>
    <AssemblyName>Hangar</AssemblyName>
    <!-- What Windows shows for the exe (Task Manager, notification headers): the version resource's
         description, which otherwise repeats AssemblyName. -->
    <AssemblyTitle>Hangar</AssemblyTitle>
    <Product>Hangar</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- The exe's icon in Explorer and Task Manager. A Win32 resource, so only where there is a Windows
       exe to put it in. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationIcon>..\assets\hangar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- Logoff/shutdown notification for a daemon started at logon (see Program.Main). Part of the
         Windows desktop framework before; a package now that the daemon targets plain net10.0. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="SshNet.Agent" Version="2026.0.0" />
    <!-- Web Push (VAPID) so the server can notify a subscribed browser/PWA even when its tab is closed. -->
    <PackageReference Include="WebPush" Version="1.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire types, the VT stripper and the ring buffer are compiled into both this project and
         Hangar.PtyHost: they are the contract between the two processes, so they must not drift. -->
    <Compile Include="..\shared\Pty\*.cs" LinkBase="Sessions\Pty\Shared" />
    <!-- Likewise the contract with the tray: the session and project records it deserializes, and the
         instance file it finds this daemon through. -->
    <Compile Include="..\shared\Contract\*.cs" LinkBase="Contract" />
    <!-- Where the data folder is, which every process of the app has to agree on. -->
    <Compile Include="..\shared\Common\*.cs" LinkBase="Common" />
    <Using Include="Hangar.Contract" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-app updater runs this after the app stops (a running exe can't overwrite itself), so it
         has to travel inside the exe rather than sit in the install folder it's about to mirror over. -->
    <EmbeddedResource Include="..\scripts\apply-update.ps1" LogicalName="Hangar.Server.apply-update.ps1" />
    <!-- Its Linux and macOS counterpart. Kept LF by .gitattributes: a CRLF checkout on Windows would
         otherwise embed a script /bin/sh can't run. -->
    <EmbeddedResource Include="..\scripts\apply-update.sh" LogicalName="Hangar.Server.apply-update.sh" />
  </ItemGroup>

  <!-- The built React app lives in wwwroot; the Web SDK includes and publishes it automatically. -->

  <!-- Local runs (scripts\dev.ps1, scripts\run.ps1, F5) need the pty host beside the app, or no session
       can launch: build it and drop its output in a "ptyhost" subfolder, which PtyHostLauncher looks in
       after the published layout. A released build never takes this path - scripts\build.ps1 publishes
       the host as a single trimmed exe straight into ./publish. -->
  <ItemGroup>
    <ProjectReference Include="..\ptyhost\Hangar.PtyHost.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyPtyHostForLocalRun" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true'">
    <ItemGroup>
      <PtyHostBuildOutput Include="..\ptyhost\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PtyHostBuildOutput)" DestinationFolder="$(OutDir)ptyhost\%(RecursiveDir)" SkipUnchangedFiles="true" Condition="'@(PtyHostBuildOutput)' != ''" />
  </Target>

</Project>
